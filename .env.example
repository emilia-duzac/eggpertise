# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas valores reales al repo. En producción se cargan en Vercel:
# Project > Settings > Environment Variables (ver docs/deploy.md).

# --- Contentful (contenido del sitio) -------------------------------------
# Space ID: Contentful > Settings > API keys (o la URL: /spaces/<ID>/...)
CONTENTFUL_SPACE_ID=
# Content Delivery API token (solo lectura, contenido publicado)
CONTENTFUL_DELIVERY_TOKEN=

# --- Resend (envío de emails de los formularios) --------------------------
# El dominio eggpertise.com tiene que estar verificado en Resend, porque los
# emails salen desde noreply@eggpertise.com.
RESEND_API_KEY=
# Casilla que recibe las consultas. Si falta, se usa info@eggpertise.com.
CONTACT_EMAIL=
# Dominio desde el que se envían los mails (noreply@<dominio>). Opcional: si falta
# se usa eggpertise.com. Sirve para enviar desde un subdominio verificado en
# Resend, por ejemplo mail.eggpertise.com.
MAIL_DOMAIN=

# --- Planilla de leads (Google Apps Script) -------------------------------
# URL /exec de la Web App de Apps Script. Si falta, los leads NO se copian a
# la planilla y no se muestra ningún error (el email sale igual).
LEADS_SHEET_ENDPOINT=
# Secreto compartido: debe ser idéntico a SHARED_SECRET en el Apps Script.
LEADS_SHEET_TOKEN=
